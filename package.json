{
  "name": "phonebridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @phonebridge/web dev",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:smartdoc": "node scripts/download-smartdoc.ts",
    "bench:vision": "node bench/vision/run.ts",
    "evidence": "node scripts/evidence.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.3",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
